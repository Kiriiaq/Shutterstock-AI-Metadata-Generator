# Shutterstock AI Metadata Generator - GitIgnore

# Secrets & Environment
.env
.env.*
!.env.example

# Compiled license secret (generated by build.py from .env, must NEVER
# be committed — anyone with this file can forge Pro keys)
src/modules/licensing/_secret_compiled.py

# Internal seller cheat-sheet (pricing + key-generation workflow). Marked
# "ne pas publier" — kept local so it never lands in the public repo.
# Run `git add -f vente.html` if you want to version it in a private repo.
vente.html

