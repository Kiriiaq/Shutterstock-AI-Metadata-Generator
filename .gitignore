# Shutterstock AI Metadata Generator - GitIgnore

# Secrets & Environment
.env
.env.*
!.env.example

# Compiled license secret (generated by build.py from .env, must NEVER
# be committed — anyone with this file can forge Pro keys)
src/modules/licensing/_secret_compiled.py

# Internal seller cheat-sheet (pricing + key-generation workflow). Marked
# "ne pas publier" — kept local so it never lands in the public repo.
# Run `git add -f vente.html` if you want to version it in a private repo.
vente.html

# Internal working docs — kept local, never published on the public repo.
# Commercial strategy (revenue projections, pricing rationale, launch
# checklist, marketing drafts) and the internal audit history: useful to
# the maintainer, pure noise (or oversharing) for a visitor.
docs/MONETIZATION.md
LAUNCH_PROCEDURE.html
LINKEDIN_DRAFTS.md
PROJECT_OVERVIEW.html
AUDIT.md
audit/

# Gumroad delivery bundle — buyer-facing files + the ~33 MB binary,
# assembled by hand for the paid channel, not part of the free repo.
packaging/gumroad/

# ExifTool backups written next to edited images when create_backup=True
*_original

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
eggs/
*.egg-info/
*.egg
.eggs/

# Virtual environments
venv/
ENV/
env/
.venv/

# PyInstaller
*.manifest
*.spec

# Coverage artifacts (pytest-cov)
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Logs
*.log
shutterstock_analyzer.log

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Application specific
.processing_state.json
nul

# Test images and data (don't commit user photos)
Shutterstock Image/
Shutterstock  Image/
Valid/
Invalid/
Shutterstock/
Shutterstock_*/
photos_unmatched/

# Temporary files
*.tmp
*.temp
*.bak

# Claude Code
.claude/
tmpclaude-*
