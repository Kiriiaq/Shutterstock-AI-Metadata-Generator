# ShutterstockAnalyzer — environment template
# Copy this file to ``.env`` (which is .gitignore'd) and fill in real values.
# NEVER commit a real .env file.

# Secret used to HMAC-sign Pro license keys.
# Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# This secret is consumed by:
#   - build.py        — embeds it into the EXE at build time
#   - tools/generate_license.py — signs keys you ship to customers
#   - src/modules/licensing/license.py — verifies signatures at runtime
#
# Rotate by issuing a new secret + rebuilding the EXE + reissuing all
# active customer keys. Customers re-paste the new key in Settings →
# Licence. Plan a rotation only if you suspect the secret is leaked.
SSA_LICENSE_SECRET=replace-with-secrets-token_urlsafe-32-output
